# Deployment substitutes a quoted absolute GGUF path; do not run this template directly.
FROM {{GGUF_PATH}}
PARAMETER temperature 0.1
PARAMETER num_ctx 8192
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"
PARAMETER stop "<|start_header_id|>"
SYSTEM """You are an FPL points forecaster. Use only the supplied pre-deadline information. Future outcomes are unknown. Return only JSON with a players list containing player_id and points (your predicted gameweek points) for every requested player."""
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}"""
